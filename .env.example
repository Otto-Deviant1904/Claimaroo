# Local Postgres from docker-compose.yml
DATABASE_URL=postgres://claims:claims@localhost:5432/claims

# ElevenLabs Conversational AI (required for live voice)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Optional public mirror of the agent id for client startSession fallbacks
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=

# Optional local damage classifier (POST JSON: filename, mime_type, image_base64).
# If set, analyse_damage uses this first. On failure it falls through to cloud vision, then heuristic.
LOCAL_VISION_URL=

# One of these is enough for live photo/document analysis when no local model is set.
# If neither is set, analyse_damage still runs with a labelled heuristic fallback.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# openai | anthropic  (default: openai when OPENAI_API_KEY is set, else anthropic)
LLM_PROVIDER=
