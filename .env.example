# Local Postgres from docker-compose.yml
DATABASE_URL=postgres://claims:claims@localhost:5432/claims
# Hosted (Render / Supabase / Neon): add ?sslmode=require and use port 5432, not pooler 6543.

# ElevenLabs Conversational AI (required for live voice)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=agent_4301m2aeyrxterxa6h7vc2bnmx9e
# Public agents can start with { agentId } and no API key on the call
ELEVENLABS_AGENT_PUBLIC=true

# Optional public mirror of the agent id for client startSession fallbacks
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=

# Optional local damage classifier (POST JSON: filename, mime_type, image_base64).
# If set, analyse_damage uses this first. On failure it falls through to cloud vision, then heuristic.
# Laptop: http://127.0.0.1:8901/analyse  |  Vercel: https://<cloudflared>/analyse
# Colab: run serve cell in notebooks/colab_nb.ipynb (or notebooks/colab-serve-cell.py)
LOCAL_VISION_URL=

# Live photo analysis via OpenAI-compatible APIs (OpenAI or DeepSeek).
# DeepSeek example:
#   OPENAI_API_KEY=sk-...
#   OPENAI_BASE_URL=https://api.deepseek.com
#   OPENAI_VISION_MODEL=deepseek-flash
# AgentRouter is NOT supported (rejects non–Claude-Code clients).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# OpenAI-compatible gateway (default: https://api.openai.com/v1)
OPENAI_BASE_URL=
# Vision model id (default: gpt-4o-mini). DeepSeek: deepseek-flash
OPENAI_VISION_MODEL=

# openai | anthropic  (default: openai when OPENAI_API_KEY is set, else anthropic)
LLM_PROVIDER=
